# Cadastre server configuration. Copy to cadastre.env (same folder as cadastre-server.exe) and edit.
# One KEY=value per line, no quotes, no spaces around "=". Lines starting with # are ignored.
# Restart the server after changing it (stop-cadastre.ps1, then start-cadastre.ps1).

# PostgreSQL + PostGIS. The database must exist and the postgis + uuid-ossp extensions must be
# installable (migrations create them on first start).
# On 10.10.10.4: PostgreSQL 14 on 5433 (5432 is 9.2). setup-database.ps1 fills this line in.
CADASTRE_DATABASE_URL=postgres://cadastre:CHANGE_ME@localhost:5433/cadastre

# 8080 on 10.10.10.4 is the PLAGIS Liferay portal; use another port.
CADASTRE_BIND=0.0.0.0:8090

# disabled = every request is a superuser. Staging on the internal network only.
CADASTRE_AUTH=disabled
# CADASTRE_KEYCLOAK_ISSUER=http://10.10.10.4:8180/realms/cadastre
# CADASTRE_KEYCLOAK_AUDIENCE=cadastre-server

RUST_LOG=info,cadastre_server=info

# Uploaded job documents (relative to the install folder).
CADASTRE_FILES_DIR=files

# Read-only catalog folders, name=path;name=path. The task runs as SYSTEM, which reaches network
# shares as the computer account (MC$): grant it read access, or use a local path.
# CADASTRE_CATALOG_FOLDERS=\\PRODUCTIONMC\Image=\\10.10.10.6\Image

# Aumentum Registry (LRS43) link sync, read-only. Leave unset to keep staging off the Registry.
# NEVER set CADASTRE_REGISTRY_WRITE=1 on staging: it writes to the production Registry.
# CADASTRE_REGISTRY_URL=http://10.10.10.5:8080/lrs/api/
# CADASTRE_REGISTRY_USER=
# CADASTRE_REGISTRY_PASSWORD=

# Credentials the Registry uses to call this server's LRSWebServices.asmx (job service).
# CADASTRE_MC_SERVICE_USER=
# CADASTRE_MC_SERVICE_PASSWORD=
