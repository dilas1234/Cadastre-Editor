# Copy to .env for local development. These match docker-compose.yml.

# PostgreSQL/PostGIS connection string.
CADASTRE_DATABASE_URL=postgres://cadastre:cadastre@localhost:5432/cadastre

# HTTP bind address.
CADASTRE_BIND=0.0.0.0:8080

# Auth enforcement: disabled | enabled.
# "disabled" runs every request as a dev superuser (admin+editor+reviewer+approver) —
# local dev only. "enabled" requires a Keycloak bearer token and verifies its RS256
# signature against the JWKS (see below).
CADASTRE_AUTH=disabled

# Keycloak realm issuer. When CADASTRE_AUTH=enabled and no inline/file JWKS is given,
# keys are fetched from {issuer}/protocol/openid-connect/certs (http:// only for now;
# https fetch lands in Phase 9 with the TLS stack). The token's `iss` is validated
# against this, and `aud` against CADASTRE_KEYCLOAK_AUDIENCE when set.
CADASTRE_KEYCLOAK_ISSUER=http://localhost:8081/realms/cadastre
CADASTRE_KEYCLOAK_AUDIENCE=cadastre-server

# Optional JWKS overrides (skip live fetch): inline JSON or a file path.
# CADASTRE_KEYCLOAK_JWKS_JSON={"keys":[...]}
# CADASTRE_KEYCLOAK_JWKS_PATH=/etc/cadastre/jwks.json

# Log filter (optional).
RUST_LOG=info,cadastre_server=debug,tower_http=debug
