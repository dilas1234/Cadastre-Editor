{
  "realm": "cadastre",
  "displayName": "PLAGIS CADASTRE",
  "enabled": true,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 3,
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 2400,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Administration (Aumentum admins, ds_gral_admin)" },
      { "name": "editor", "description": "Capture and edit parcels under jobs" },
      { "name": "reviewer", "description": "Review jobs" },
      { "name": "approver", "description": "Approve and post jobs" }
    ]
  },
  "clients": [
    {
      "clientId": "cadastre-editor",
      "name": "PLAGIS CADASTRE Editor",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+" },
      "redirectUris": ["http://10.10.10.9:8080/editor*", "http://10.10.10.128:8080/editor*", "http://localhost:8080/editor*", "http://localhost:18080/editor*", "http://10.10.10.9:18080/editor*"],
      "webOrigins": ["+"]
    }
  ]
}
